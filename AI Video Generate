<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Video Studio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        dark: {
                            900: '#0b0f19',
                            800: '#131824',
                            700: '#1e2538'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-dark-900 text-white min-h-screen flex flex-col items-center justify-center p-4">

    <div class="w-full max-w-xl bg-dark-800 border border-dark-700 rounded-2xl p-6 shadow-2xl">
        <h1 class="text-2xl font-bold mb-4 text-center bg-gradient-to-r from-cyan-400 to-indigo-500 bg-clip-text text-transparent">AI Video Studio</h1>
        
        <!-- Prompt Input -->
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-400 mb-2">Enter your prompt</label>
            <input type="text" id="promptInput" placeholder="e.g., A school student working in a shop" class="w-full bg-dark-900 border border-dark-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-cyan-500">
        </div>

        <!-- Generate Button -->
        <button onclick="generateVideo()" class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-semibold py-3 rounded-xl transition duration-200 shadow-lg mb-6">
            Generate Video
        </button>

        <!-- Video Result Section -->
        <div id="resultSection" class="hidden border border-dark-700 bg-dark-900 rounded-xl p-4">
            <div class="flex justify-between items-center mb-3">
                <span class="text-sm font-medium text-emerald-400 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span> Completed
                </span>
                <span id="videoPromptDisplay" class="text-xs text-gray-400 truncate max-w-[200px]"></span>
            </div>

            <video id="videoPlayer" controls class="w-full rounded-lg mb-4 bg-black aspect-video object-cover">
                Your browser does not support the video tag.
            </video>

            <a id="downloadBtn" href="#" download="ai-video.mp4" class="block text-center bg-gradient-to-r from-blue-600 to-indigo-600 hover:opacity-90 text-white font-medium py-2.5 rounded-lg transition">
                Download Video
            </a>
        </div>
    </div>

    <script>
        function generateVideo() {
            const prompt = document.getElementById('promptInput').value.trim();
            if(!prompt) {
                alert('Please enter a prompt first!');
                return;
            }

            const resultSection = document.getElementById('resultSection');
            const videoPlayer = document.getElementById('videoPlayer');
            const videoPromptDisplay = document.getElementById('videoPromptDisplay');
            const downloadBtn = document.getElementById('downloadBtn');

            resultSection.classList.remove('hidden');
            videoPromptDisplay.innerText = prompt;

            // Public sample working video for preview
            const sampleVideoUrl = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4';
            
            videoPlayer.src = sampleVideoUrl;
            downloadBtn.href = sampleVideoUrl;
            videoPlayer.load();
        }
    </script>
</body>
</html>
